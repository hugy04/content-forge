# =============================================================================
# TEXT GENERATION
# =============================================================================
# Which backend writes the content. "gemini" is the default: the AI Studio free
# tier costs nothing and one key covers both text and images.
# Switch to "claude" if you have Anthropic API credits - the pipeline is
# identical, only this line changes.
TEXT_PROVIDER=gemini

# Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Leave as-is unless scripts/gemini_doctor.py tells you otherwise. Google
# retires Flash model ids regularly; the provider auto-resolves to the newest
# available id if this one is gone.
# Measured 9 Nov 2026: gemini-3.8-flash and gemini-flash-latest return 503
# "high demand" on a free key; 3.6 serves reliably. The provider also
# falls forward across models at runtime, so this is a preference.
GEMINI_MODEL=gemini-3.6-flash

# Only needed when TEXT_PROVIDER=claude. Requires prepaid credits at
# https://platform.claude.com/settings/keys - not covered by a Claude Pro plan.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Per-stage model overrides. Blank = use the active provider's model above.
OUTLINE_MODEL=
DRAFT_MODEL=
PROMPT_MODEL=
OUTLINE_EFFORT=medium
DRAFT_EFFORT=medium
PROMPT_EFFORT=low

# Optional: model paid-tier economics while running on a free key.
# PRICE_INPUT_PER_MTOK=0.30
# PRICE_OUTPUT_PER_MTOK=2.50

# ---- required: text generation ----

# ---- models (one per stage, so you can route cost/latency per stage) ----

# ---- content contract ----
TARGET_WORDS_MIN=500
TARGET_WORDS_MAX=800
MAX_REVISIONS=2
DEADLINE_SECONDS=300

# ---- image providers: ordered fallback chain ----
# Gemini image models answer 429 (no free-tier image quota) as of Nov 2026,
# so they are out of the default chain. Add `gemini,` back on a paid key.
IMAGE_PROVIDERS=pollinations,card
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
IMAGE_TIMEOUT_SECONDS=90
POLLINATIONS_MODEL=flux
# optional alternates
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- output sinks (comma separated: local,gdrive) ----
SINKS=local
GDRIVE_WEBAPP_URL=
GDRIVE_SHARED_SECRET=

# ---- diversity ----
DIVERSITY_COOLDOWN=3
DIVERSITY_HISTORY=50

# ---- execution ----
RUN_MODE=inline
REDIS_URL=redis://localhost:6379/0
FAKE_PROVIDERS=0
NOTIFY_URL=

# ---- required: text generation ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- models (one per stage, so you can route cost/latency per stage) ----
OUTLINE_MODEL=claude-opus-5-5
DRAFT_MODEL=claude-opus-5-5
PROMPT_MODEL=claude-opus-5-5
OUTLINE_EFFORT=medium
DRAFT_EFFORT=medium
PROMPT_EFFORT=low

# ---- content contract ----
TARGET_WORDS_MIN=500
TARGET_WORDS_MAX=800
MAX_REVISIONS=2
DEADLINE_SECONDS=300

# ---- image providers: ordered fallback chain ----
IMAGE_PROVIDERS=gemini,pollinations,card
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
IMAGE_TIMEOUT_SECONDS=90
POLLINATIONS_MODEL=flux
# optional alternates
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- output sinks (comma separated: local,gdrive) ----
SINKS=local
GDRIVE_WEBAPP_URL=
GDRIVE_SHARED_SECRET=

# ---- diversity ----
DIVERSITY_COOLDOWN=3
DIVERSITY_HISTORY=50

# ---- execution ----
RUN_MODE=inline
REDIS_URL=redis://localhost:6379/0
FAKE_PROVIDERS=0
NOTIFY_URL=
